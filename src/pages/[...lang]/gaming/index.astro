---
import floor from '../../../assets/photos/floor.jpg';
import Button from '../../../components/Button.astro';
import GameRow from '../../../components/GameRow.astro';
import Page from '../../../layouts/Page.astro';
import { entries } from '../../../lib/content';
import { langParams, localePath, strings, type Locale } from '../../../lib/i18n';

export const getStaticPaths = () => langParams();

const { locale } = Astro.props as { locale: Locale };
const t = strings(locale);
const games = await entries('games', locale);
---

<Page
  locale={locale}
  path="/gaming/"
  title={t.gaming.title}
  description={t.gaming.description}
  intro={t.gaming.intro}
  photo={floor}
  photoAlt={t.wayIn.stops[6]?.alt ?? ''}
>
  <section class="pits wrap" aria-labelledby="pits">
    <h2 id="pits">{t.gaming.pits}</h2>
    <div class="pit" id="normal-pit">
      <h3>{t.gaming.normalPit}</h3>
      <p>{t.gaming.normalPitText}</p>
    </div>
    <div class="pit" id="vip-pit">
      <h3>{t.gaming.vipPit}</h3>
      <p>{t.gaming.vipPitText}</p>
    </div>
  </section>

  <section class="games wrap" aria-labelledby="games">
    <h2 id="games">{t.gaming.games}</h2>
    <ul>
      {games.map((game) => (
        <GameRow locale={locale} game={game} />
      ))}
    </ul>
  </section>

  <section class="before wrap" aria-labelledby="before-you-play">
    <h2 id="before-you-play">{t.gaming.beforeYouPlay}</h2>
    <p>{t.gaming.beforeYouPlayText}</p>
    <Button href={localePath(locale, '/responsible-gaming/')} variant="secondary">
      {t.gaming.playLink}
    </Button>
  </section>
</Page>

<style>
  section {
    padding-block: 3rem;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: var(--text-section);
  }

  .pits {
    display: grid;
    gap: 1.5rem;
  }

  .pit {
    padding-top: 1rem;
    border-top: var(--rule) solid var(--line);
  }

  .pit h3 {
    margin: 0 0 0.5rem;
    font-size: var(--text-24);
  }

  .pit p {
    max-width: 44ch;
    margin: 0;
  }

  .games ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .before p {
    max-width: 52ch;
    margin: 0 0 1.5rem;
  }

  @media (width >= 48rem) {
    .pits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }

    .pits h2 {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 64rem) {
    section {
      padding-block: 4rem;
    }
  }
</style>
