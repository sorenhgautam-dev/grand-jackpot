---
import { getImage } from 'astro:assets';
import entrance from '../../assets/photos/entrance.jpg';
import floor from '../../assets/photos/floor.jpg';
import Button from '../../components/Button.astro';
import EventList from '../../components/EventList.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import HoursTable from '../../components/HoursTable.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import Venue from '../../components/Venue.astro';
import WayIn from '../../components/WayIn.astro';
import { directionsUrl, site } from '../../data/site';
import Base from '../../layouts/Base.astro';
import { entries, slugOf } from '../../lib/content';
import { langParams, localePath, strings, type Locale } from '../../lib/i18n';
import { casinoJsonLd } from '../../lib/schema';

export const getStaticPaths = () => langParams();

const { locale } = Astro.props as { locale: Locale };
const t = strings(locale);
const [events, games, venues] = await Promise.all([
  entries('events', locale),
  entries('games', locale),
  entries('venues', locale),
]);
const og = await getImage({ src: entrance, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const jsonLd = casinoJsonLd(new URL(localePath(locale), Astro.site), new URL(og.src, Astro.site));
---

<Base
  locale={locale}
  path="/"
  title={t.home.title}
  description={t.meta.siteDescription}
  home
  jsonLd={jsonLd}
>
  <Hero locale={locale} />

  <section class="tonight wrap section" aria-labelledby="tonight">
    <div class="head">
      <h2 id="tonight">{t.home.tonight}</h2>
      <Button href={localePath(locale, '/whats-on/')} variant="secondary">
        {t.common.seeAllEvents}
      </Button>
    </div>
    <div class="body">
      <EventList locale={locale} events={events} days={2} limit={3} />
    </div>
  </section>

  <section class="gaming wrap section" aria-labelledby="gaming">
    <Photo
      src={floor}
      alt={t.wayIn.stops[6]?.alt ?? ''}
      ratio="landscape"
      sizes="(min-width: 64rem) 55vw, 100vw"
      class="gaming-photo"
    />
    <div class="gaming-text">
      <h2 id="gaming">{t.home.gaming}</h2>
      <p class="lede">{t.home.gamingText}</p>
      <ul class="game-names" data-stagger>
        {games.map((game) => (
          <li>
            <a href={localePath(locale, `/gaming/${slugOf(game.id)}/`)}>
              <span>{game.data.title}</span>
              <Icon name="arrow" class="go" />
            </a>
          </li>
        ))}
      </ul>
      <Button href={localePath(locale, '/gaming/')} variant="secondary">
        {t.home.gamingLink}
      </Button>
    </div>
  </section>

  <Marquee items={games.map((game) => game.data.title)} />

  <section class="dining wrap section" aria-labelledby="dining">
    <div class="head head-row">
      <h2 id="dining">{t.home.dining}</h2>
      <Button href={localePath(locale, '/dining/')} variant="secondary">
        {t.home.diningLink}
      </Button>
    </div>
    <div class="venues" data-stagger>
      {venues.map((venue) => (
        <Venue locale={locale} venue={venue} />
      ))}
    </div>
  </section>

  <section class="packages" data-surface="umber" aria-labelledby="packages">
    <div class="wrap packages-inner">
      <h2 id="packages">{t.home.packages}</h2>
      <div class="packages-text">
        <p class="lede">{t.home.packagesText}</p>
        <Button href={localePath(locale, '/packages/')}>{t.common.seePackages}</Button>
      </div>
    </div>
  </section>

  <WayIn locale={locale} heading={t.home.wayIn} />

  <section class="before" data-surface="charcoal" aria-labelledby="before">
    <div class="wrap section">
      <div class="head">
        <h2 id="before">{t.home.beforeYouGo}</h2>
      </div>
      <dl class="reference body" data-stagger>
        <div>
          <dt class="label">{t.home.hoursLabel}</dt>
          <dd>
            <HoursTable locale={locale} />
          </dd>
        </div>
        <div>
          <dt class="label">{t.home.entryLabel}</dt>
          <dd>{t.home.entryValue}</dd>
        </div>
        <div>
          <dt class="label">{t.home.gettingHereLabel}</dt>
          <dd>{t.home.gettingHereValue}</dd>
        </div>
        <div>
          <dt class="label">{t.home.addressLabel}</dt>
          <dd>
            <address>
              {site.hotel}, {site.address.street}, {site.address.locality}
            </address>
            <Button
              href={directionsUrl}
              rel="noopener"
              variant="secondary"
              icon="pin"
              class="directions"
            >
              {t.common.directions}
            </Button>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* One rhythm: every section is --section-space tall at each end; light sections that follow
     one another are divided by a hairline. Content sits on a 12-column grid. */
  .section {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: var(--space-6);
    padding-block: var(--section-space);
  }

  .section > * {
    grid-column: 1 / -1;
  }

  /* Gold hairlines divide the black sections; the charcoal band needs none. */
  .tonight,
  .gaming {
    border-top: var(--rule) solid var(--line);
  }

  h2 {
    margin: 0;
    font-size: var(--text-section);
  }

  .head {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    justify-items: start;
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .lede {
    max-width: 40ch;
    margin: 0;
    font-size: var(--text-21);
    line-height: var(--line-snug);
  }

  .lede:lang(hi) {
    line-height: 1.6;
  }

  .gaming-text {
    display: grid;
    gap: var(--space-5);
    align-content: center;
    justify-items: start;
  }

  /* The games as an index: a name, and an arrow that slides in when you point at it. */
  .game-names {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-5);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game-names a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: calc(var(--tap) + var(--space-2));
    border-bottom: var(--rule) solid var(--line);
    font-family: var(--font-display);
    font-size: var(--text-21);
    line-height: var(--line-tight);
    text-decoration: none;
  }

  .game-names a span {
    transition: translate var(--dur-hover) var(--ease-expo);
  }

  .game-names :global(.go) {
    flex: none;
    width: 1.125rem;
    color: var(--accent);
    opacity: 0;
    translate: calc(-1 * var(--space-3)) 0;
    transition:
      opacity var(--dur-hover) var(--ease-expo),
      translate var(--dur-hover) var(--ease-expo);
  }

  .venues {
    display: grid;
    gap: var(--space-7);
  }

  .packages {
    padding-block: var(--section-space);
  }

  .packages-inner {
    display: grid;
    gap: var(--space-5);
  }

  .packages-text {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .reference {
    margin: 0;
  }

  .reference > div {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: var(--rule) solid var(--line);
  }

  dd {
    margin: 0;
    max-width: 52ch;
  }

  address {
    font-style: normal;
  }

  dd :global(.directions) {
    margin-top: var(--space-4);
  }

  @media (hover: hover) {
    .game-names a:hover span {
      translate: var(--space-2) 0;
    }

    .game-names a:hover :global(.go) {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (width >= 48rem) {
    .venues {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .reference > div {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  @media (width >= 64rem) {
    .tonight .head,
    .before .head {
      grid-column: 1 / span 4;
    }

    .tonight .body,
    .before .body {
      grid-column: 6 / -1;
    }

    .gaming {
      align-items: center;
    }

    .gaming :global(.gaming-photo) {
      grid-column: 1 / span 7;
    }

    .gaming .gaming-text {
      grid-column: 9 / -1;
    }

    .packages-inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: end;
    }

    .packages-inner h2 {
      grid-column: 1 / span 5;
      font-size: var(--text-96);
      line-height: var(--line-display);
    }

    .packages-text {
      grid-column: 7 / -1;
    }
  }
</style>
