---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

/** The crops the site uses. Every photograph is one of these. */
const ratios = { wide: 16 / 9, landscape: 3 / 2, portrait: 4 / 5 } as const;

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio: keyof typeof ratios;
  /** CSS `sizes`, describing the width the photo takes in the layout. */
  sizes: string;
  /** The page's LCP image: loaded eagerly at high priority and never faded. */
  priority?: boolean;
  /** Top edge follows the casino's entrance arch. */
  arch?: boolean;
  /** Focal point for the crop, as an `object-position` value. */
  position?: string;
  transitionName?: string | undefined;
  class?: string | undefined;
}

const {
  src,
  alt,
  ratio,
  sizes,
  priority = false,
  arch = false,
  position = 'center',
  transitionName,
  class: className,
} = Astro.props;

const width = Math.min(src.width, Math.round(src.height * ratios[ratio]));
const height = Math.round(width / ratios[ratio]);
const style = [
  `--object-position: ${position}`,
  transitionName && `view-transition-name: ${transitionName}`,
]
  .filter(Boolean)
  .join('; ');
---

<div
  class:list={['photo', className]}
  data-ratio={ratio}
  data-arch={arch ? '' : undefined}
  style={style}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    width={width}
    height={height}
    fit="cover"
    position={position}
    layout="full-width"
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? undefined : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    data-fade={priority ? undefined : ''}
  />
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: var(--ground);
  }

  .photo[data-ratio='wide'] {
    aspect-ratio: 16 / 9;
  }

  .photo[data-ratio='landscape'] {
    aspect-ratio: 3 / 2;
  }

  .photo[data-ratio='portrait'] {
    aspect-ratio: 4 / 5;
  }

  .photo[data-arch] {
    border-radius: var(--radius-arch);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--object-position);
  }
</style>
