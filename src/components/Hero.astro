---
import floor from '../assets/photos/floor.jpg';
import { site } from '../data/site';
import { formatPhone } from '../lib/format';
import { strings, type Locale } from '../lib/i18n';
import FlagString from './FlagString.astro';
import OpeningStatus from './OpeningStatus.astro';
import Photo from './Photo.astro';
import Ridge from './Ridge.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale);

/** The name in two lines: "Grand Jackpot" in italic, "Casino" upright beneath it. */
const [first = site.name, last = ''] = site.name.split(/ (?=\S+$)/);
const street = site.address.street.split(',')[0];
const phone = site.phones[0];
---

<section class="hero" data-surface="ink" data-hero aria-labelledby="hero-title">
  <div class="backdrop">
    <Photo
      src={floor}
      alt={t.wayIn.stops[6]?.alt ?? ''}
      ratio="wide"
      sizes="(max-aspect-ratio: 16/9) 178vh, 100vw"
      position="42% 50%"
      priority
    />
    <div class="glow"></div>
  </div>

  <svg
    class="prayer-flags"
    viewBox="0 0 1000 66"
    preserveAspectRatio="xMidYMin slice"
    aria-hidden="true"
    focusable="false"
  >
    <FlagString from={[-6, 2]} to={[1006, 2]} sag={18} count={32} arrive="load" />
  </svg>

  <div class="content wrap">
    <p class="kicker">
      <span class="namaste" lang="ne">
        नमस्ते
      </span>
      <span class="label" lang="en">
        {site.hotel} · {street}
      </span>
    </p>
    <h1 id="hero-title" class="title" lang="en">
      <span class="visually-hidden">{site.name}</span>
      <span class="line one" aria-hidden="true">
        <em>{first}</em>
      </span>
      <span class="line two" aria-hidden="true">
        {last}
      </span>
    </h1>
    <p class="lede">{t.home.line}</p>
  </div>

  <div class="foot wrap">
    <Ridge flat />
    <div class="foot-row">
      <OpeningStatus locale={locale} />
      {phone && (
        <p class="call">
          <span>{t.footer.call}</span>
          <a href={`tel:${phone}`}>{formatPhone(phone)}</a>
        </p>
      )}
    </div>
  </div>
</section>

<script>
  /* A warm light follows the pointer across the photograph, as if you were looking around. */
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let frame = 0;
    let x = 0;
    let y = 0;
    hero.addEventListener('pointermove', (event) => {
      const box = hero.getBoundingClientRect();
      x = event.clientX - box.left;
      y = event.clientY - box.top;
      frame ||= requestAnimationFrame(() => {
        frame = 0;
        hero.style.setProperty('--mx', `${x}px`);
        hero.style.setProperty('--my', `${y}px`);
        hero.dataset.lit = '';
      });
    });
    hero.addEventListener('pointerleave', () => delete hero.dataset.lit);
  }
</script>

<style>
  .hero {
    /* Measured from the window's top edge, for the photograph's drift as the hero leaves. */
    view-timeline: --hero block;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: max(36rem, 100svh);
    overflow: clip;
  }

  /* ---------- The photograph: full bleed, toned down so the words over it read ---------- */

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .backdrop :global(.photo[data-ratio]),
  .backdrop :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    background: var(--color-ink);
  }

  /* The stills are daylight phone video: cooler, darker and less saturated, they sit at night. */
  .backdrop :global(img) {
    height: 100%;
    filter: saturate(0.7) sepia(0.12) brightness(0.6) contrast(1.06);
  }

  /* Dark at the top for the header, a pool of shade behind the name, dark again at the foot. */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 42% at 50% 50%, rgb(10 12 14 / 0.5), transparent 72%),
      linear-gradient(
        to bottom,
        rgb(10 12 14 / 0.72) 0%,
        rgb(10 12 14 / 0.18) 26%,
        rgb(10 12 14 / 0.22) 62%,
        rgb(10 12 14 / 0.86) 100%
      );
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      circle 22rem at var(--mx, 50%) var(--my, 50%),
      rgb(255 214 150 / 0.55),
      transparent 72%
    );
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }

  .hero[data-lit] .glow {
    opacity: 1;
  }

  /* ---------- The words ---------- */

  /* ---------- Prayer flags, strung across under the header ---------- */

  .prayer-flags {
    --flags-height: clamp(3.25rem, 6.6vw, 6.5rem);
    position: absolute;
    top: var(--header-full);
    inset-inline: 0;
    display: block;
    width: 100%;
    height: var(--flags-height);
    pointer-events: none;
    filter: drop-shadow(0 0.4rem 0.5rem rgb(10 12 14 / 0.45));
  }

  .content {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-5);
    /* Clear of the header and the flags under it. */
    padding-block: calc(var(--header-full) + clamp(3.25rem, 6.6vw, 6.5rem)) var(--space-6);
    text-align: center;
  }

  .kicker {
    display: grid;
    justify-items: center;
    margin: 0;
  }

  .kicker .label {
    color: var(--fg);
  }

  /* "Namaste", in the system's Devanagari face (see --font-native-label in tokens.css). */
  .namaste {
    color: var(--color-gold-light);
    font-family: var(--font-native-label);
    font-size: var(--text-21);
    line-height: 1.5;
  }

  .title {
    margin: 0;
    font-size: var(--text-hero);
    line-height: var(--line-display);
    font-weight: 500;
    letter-spacing: -0.025em;
    text-wrap: initial;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  /* A band of gold light runs across the name now and then, like a lamp passing a sign. */
  @supports (background-clip: text) {
    .one em {
      margin-inline: -0.12em;
      padding-inline: 0.12em;
      background: linear-gradient(
          105deg,
          var(--color-paper) 40%,
          var(--color-gold-light) 46%,
          #e6bd5c 50%,
          var(--color-gold-light) 54%,
          var(--color-paper) 60%
        )
        0 0 / 300% 100% no-repeat;
      background-position: 100% 0;
      background-clip: text;
      color: transparent;
    }
  }

  .lede {
    max-width: 36ch;
    margin: 0;
    font-size: var(--text-18);
    line-height: var(--line-body);
  }

  /* ---------- The foot: open now, and a number to call ---------- */

  .foot-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4) max(var(--space-5), env(safe-area-inset-bottom));
    font-size: var(--text-14);
  }

  /* A Himalayan skyline stands in for the rule above the foot. */
  .foot :global(.ridge) {
    aspect-ratio: auto;
    min-height: 0;
    height: clamp(2.25rem, 6vw, 4.5rem);
    color: color-mix(in oklab, var(--color-paper) 60%, transparent);
  }

  .foot-row :global(.status) {
    margin: 0;
  }

  .call {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .call span {
    color: var(--fg-muted);
  }

  .call a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-variant-numeric: tabular-nums;
  }

  @media (width >= 48rem) {
    .foot-row {
      justify-content: space-between;
    }
  }

  /* ---------- Arrival: one sequence, under a second for the words ---------- */

  @keyframes fade-in {
    from {
      opacity: 0.01;
    }
  }

  @keyframes settle {
    from {
      scale: 1.08;
    }
  }

  /* Each line of the name rises out from behind its own lower edge. */
  @keyframes line-up {
    from {
      clip-path: inset(100% -0.3em -0.4em -0.3em);
      translate: 0 0.3em;
    }

    to {
      clip-path: inset(-0.3em -0.3em -0.4em -0.3em);
      translate: 0 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 3000;
    }
  }

  @keyframes shine {
    0%,
    62% {
      background-position: 100% 0;
    }

    100% {
      background-position: 0% 0;
    }
  }

  /* As the hero leaves, the photograph drifts a little slower than the page. */
  @keyframes drift {
    to {
      translate: 0 16%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .backdrop {
      animation: fade-in 900ms var(--ease-out) both;
    }

    .backdrop :global(img) {
      animation: settle 1800ms var(--ease-expo) both;
    }

    .kicker {
      animation: rise 800ms var(--ease-expo) calc(150ms + var(--intro, 0ms)) both;
    }

    .one {
      animation: line-up 900ms var(--ease-expo) calc(240ms + var(--intro, 0ms)) both;
    }

    .one em {
      animation: shine 6.5s var(--ease-in-out) calc(400ms + var(--intro, 0ms)) infinite;
    }

    .two {
      animation: line-up 900ms var(--ease-expo) calc(340ms + var(--intro, 0ms)) both;
    }

    .lede {
      animation: rise 800ms var(--ease-expo) calc(500ms + var(--intro, 0ms)) both;
    }

    .foot {
      animation: rise 800ms var(--ease-expo) calc(620ms + var(--intro, 0ms)) both;
    }

    .foot :global(.ridge path) {
      animation: draw 3200ms cubic-bezier(0.3, 0, 0.3, 1) calc(500ms + var(--intro, 0ms)) both;
    }

    @supports (animation-timeline: view()) {
      .backdrop {
        animation:
          fade-in 900ms var(--ease-out) both,
          drift linear both;
        animation-timeline: auto, --hero;
        animation-range:
          normal,
          exit 0% exit 100%;
      }
    }
  }
</style>
