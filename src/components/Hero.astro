---
import entranceTall from '../assets/photos/entrance-tall.jpg';
import { site } from '../data/site';
import { localePath, strings, type Locale } from '../lib/i18n';
import Button from './Button.astro';
import OpeningStatus from './OpeningStatus.astro';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale);

/**
 * The name set as the picture: one word per line, alternating a heavy grotesk in capitals
 * with the display serif, placed start, indented and end. Screen readers get the name whole.
 */
const places = ['start', 'indent', 'end'] as const;
const words = site.name.split(' ').map((word, index) => ({
  word,
  face: index % 2 ? 'serif' : 'grotesk',
  place: places[index % places.length],
  index,
}));
---

<section class="hero" data-surface="dark" data-hero aria-labelledby="hero-title">
  <div class="stage wrap">
    <Photo
      src={entranceTall}
      alt={t.wayIn.stops[4]?.alt ?? ''}
      ratio="portrait"
      sizes="(min-width: 48rem) 24vw, 46vw"
      priority
      class="portrait"
    />
    <h1 id="hero-title" class="name" lang="en">
      <span class="visually-hidden">{site.name}</span>
      {words.map(({ word, face, place, index }) => (
        <span
          class="word"
          data-face={face}
          data-place={place}
          style={`--i: ${index}`}
          aria-hidden="true"
        >
          <span class="inner">{word}</span>
        </span>
      ))}
    </h1>
    <span class="mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" focusable="false">
        <path d="M12 1.5v21M1.5 12h21M4.6 4.6l14.8 14.8M19.4 4.6L4.6 19.4"></path>
      </svg>
    </span>
    <div class="aside">
      <p class="line">{t.home.line}</p>
      <OpeningStatus locale={locale} />
      <div class="buttons">
        <Button href={localePath(locale, '/visit/')}>{t.common.planVisit}</Button>
        <Button href={localePath(locale, '/whats-on/')} variant="secondary">
          {t.common.whatsOn}
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/header';
</script>

<style>
  .hero {
    /* Measure the scroll-out from the window's top edge, not below the header's padding. */
    view-timeline: --hero block;
    view-timeline-inset: 0;
    display: grid;
    align-items: center;
    min-height: max(36rem, 100svh);
    margin-top: calc(-1 * (var(--header-height) + env(safe-area-inset-top)));
    padding-top: calc(var(--header-height) + env(safe-area-inset-top));
    overflow: clip;
  }

  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-5);
    padding-block: var(--space-7) var(--space-8);
  }

  /* The entrance stands behind the words. */
  .stage :global(.portrait) {
    position: absolute;
    z-index: 0;
    top: calc(var(--space-7) + var(--text-hero) * 0.62);
    right: max(var(--gutter), env(safe-area-inset-right));
    width: 46%;
  }

  /* The words sit over it and invert where they cross it. */
  .name {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-paper);
    font-size: var(--text-hero);
    line-height: var(--line-display);
    letter-spacing: 0;
    mix-blend-mode: difference;
  }

  .word {
    display: block;
    white-space: nowrap;
  }

  .inner {
    display: inline-block;
  }

  [data-face='grotesk'] {
    font-family: var(--font-grotesk);
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  [data-face='serif'] {
    font-family: var(--font-display);
    font-size: 1.12em;
    letter-spacing: -0.02em;
  }

  [data-place='indent'] {
    padding-inline-start: 0.45em;
  }

  [data-place='end'] {
    text-align: end;
  }

  .mark {
    position: absolute;
    z-index: 2;
    top: calc(var(--space-7) + var(--text-hero) * 0.12);
    right: max(var(--gutter), env(safe-area-inset-right));
    width: calc(var(--text-hero) * 0.42);
    color: var(--accent);
  }

  .mark svg {
    width: 100%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  .aside {
    position: relative;
    z-index: 2;
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-top: var(--space-6);
  }

  .line {
    max-width: 34ch;
    margin: 0;
    font-size: var(--text-18);
    line-height: var(--line-body);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (width >= 48rem) {
    .stage :global(.portrait) {
      top: calc(var(--space-7) + var(--text-hero) * 0.42);
      right: auto;
      left: 36%;
      width: clamp(12rem, 22vw, 30rem);
    }

    .aside {
      grid-column: 8 / -1;
      margin-top: var(--space-7);
    }
  }

  @media (width >= 64rem) {
    .aside {
      grid-column: 9 / -1;
    }
  }

  /* ---------- Arrival: the words slide in from alternate sides, out of a blur ---------- */

  @keyframes word-in {
    from {
      opacity: 0.01;
      translate: var(--from) 0;
      filter: blur(0.12em);
    }
  }

  @keyframes photo-in {
    from {
      clip-path: inset(100% 0 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes photo-settle {
    from {
      scale: var(--reveal-zoom);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 var(--reveal-rise);
    }
  }

  @keyframes mark-in {
    from {
      opacity: 0;
      rotate: -120deg;
      scale: 0.4;
    }
  }

  @keyframes turn {
    to {
      rotate: 1turn;
    }
  }

  /* ---------- Leaving: the words part sideways and the photograph lifts away faster ---------- */

  @keyframes part-left {
    to {
      translate: -12% 0;
    }
  }

  @keyframes part-right {
    to {
      translate: 12% 0;
    }
  }

  @keyframes lift {
    to {
      translate: 0 -24%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .inner {
      --from: -0.6em;
      animation: word-in var(--dur-hero-word) var(--ease-expo) both;
      animation-delay: calc(120ms + var(--i) * var(--stagger-hero));
    }

    [data-place='indent'] .inner {
      --from: 0.6em;
    }

    .stage :global(.portrait) {
      animation: photo-in var(--dur-reveal-photo) var(--ease-expo) 200ms both;
    }

    .stage :global(.portrait img) {
      animation: photo-settle calc(var(--dur-reveal-photo) * 1.4) var(--ease-expo) 200ms both;
    }

    .aside {
      animation: rise var(--dur-reveal) var(--ease-expo) 650ms both;
    }

    .mark svg {
      animation:
        mark-in var(--dur-reveal) var(--ease-expo) 800ms both,
        turn 24s linear 1.8s infinite;
    }

    @supports (animation-timeline: view()) {
      .word {
        animation: part-left linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }

      [data-place='indent'] {
        animation-name: part-right;
      }

      .mark {
        animation: lift linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }

      .stage :global(.portrait) {
        animation:
          photo-in var(--dur-reveal-photo) var(--ease-expo) 200ms both,
          lift linear both;
        animation-timeline: auto, --hero;
        animation-range:
          normal,
          exit 0% exit 100%;
      }
    }
  }
</style>
