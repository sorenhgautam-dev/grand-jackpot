---
import { getImage } from 'astro:assets';
import entrance from '../assets/photos/entrance.jpg';
import entranceTall from '../assets/photos/entrance-tall.jpg';
import { site } from '../data/site';
import { localePath, strings, type Locale } from '../lib/i18n';
import Button from './Button.astro';
import OpeningStatus from './OpeningStatus.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale);

/** Phones get a 4:5 crop centred on the sign; wider screens get the whole entrance. */
const crops = [
  { src: entranceTall, widths: [480, 720, 864], media: '(max-width: 47.99rem)' },
  { src: entrance, widths: [960, 1280, 1600, 1920], media: undefined },
];
const formats = ['avif', 'webp'] as const;

const sources = await Promise.all(
  crops.flatMap((crop) =>
    formats.map(async (format) => {
      const images = await Promise.all(
        crop.widths.map((width) => getImage({ src: crop.src, width, format })),
      );
      return {
        media: crop.media,
        type: `image/${format}`,
        srcset: images.map((image, index) => `${image.src} ${crop.widths[index]}w`).join(', '),
      };
    }),
  ),
);
const fallback = await getImage({ src: entrance, width: 1280, format: 'jpg' });

/** The name, letter by letter, for the 3D intro. Screen readers get the name whole. */
let count = 0;
const words = site.name.split(' ').map((word) => [...word].map((char) => ({ char, i: count++ })));
---

<section class="hero" data-hero data-pointer aria-labelledby="hero-title">
  <picture class="photo">
    {sources.map((source) => (
      <source media={source.media} type={source.type} srcset={source.srcset} sizes="100vw" />
    ))}
    <img
      src={fallback.src}
      alt={t.wayIn.stops[4]?.alt ?? ''}
      width={entrance.width}
      height={entrance.height}
      fetchpriority="high"
      loading="eager"
    />
  </picture>
  <div class="text wrap" style={`--letters: ${count}`}>
    <h1 id="hero-title" lang="en">
      <span class="visually-hidden">{site.name}</span>
      <span class="letters" aria-hidden="true">
        {words.map((letters, index) => (
          <>
            {index > 0 && ' '}
            <span class="word">
              {letters.map(({ char, i }) => (
                <span class="char" style={`--c: ${i}`}>
                  {char}
                </span>
              ))}
            </span>
          </>
        ))}
      </span>
    </h1>
    <p class="line" style="--i: 0">
      {t.home.line}
    </p>
    <div class="actions" style="--i: 1">
      <OpeningStatus locale={locale} />
      <div class="buttons">
        <Button href={localePath(locale, '/visit/')}>{t.common.planVisit}</Button>
        <Button href={localePath(locale, '/whats-on/')} variant="secondary">
          {t.common.whatsOn}
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/header';
</script>

<style>
  .hero {
    --focus: var(--color-cream);
    --mx: 0;
    --my: 0;
    view-timeline: --hero block;
    /* Measure from the window's top edge, not below the header's scroll padding. */
    view-timeline-inset: 0;
    position: relative;
    display: grid;
    align-items: end;
    min-height: max(36rem, 100svh);
    margin-top: calc(-1 * (var(--header-height) + env(safe-area-inset-top)));
    overflow: hidden;
    background: var(--color-obsidian);
    color: var(--color-cream);
  }

  .photo,
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The photograph sits a little behind the glass and drifts against the pointer. */
  .photo {
    scale: 1.06;
    translate: calc(var(--mx) * -1.25%) calc(var(--my) * -1.25%);
    transition: translate var(--dur-follow) var(--ease-out);
  }

  .photo img {
    object-fit: cover;
    object-position: 50% 40%;
  }

  /* A warm spotlight follows the pointer across the entrance. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      circle 32rem at var(--px, 50%) var(--py, 40%),
      var(--glow),
      transparent 70%
    );
    mix-blend-mode: overlay;
    opacity: 0;
    transition: opacity var(--dur-follow) var(--ease-out);
    pointer-events: none;
  }

  .hero[data-pointing]::before {
    opacity: 1;
  }

  /* The one neutral scrim: under the header at the top, under the text at the foot. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--scrim) 0, transparent calc(var(--header-height) * 2.25)),
      linear-gradient(to top, var(--scrim) 0, var(--scrim) 22%, transparent 64%);
    z-index: 1;
    pointer-events: none;
  }

  .text {
    position: relative;
    z-index: 2;
    translate: calc(var(--mx) * 0.75rem) calc(var(--my) * 0.5rem);
    transition: translate var(--dur-follow) var(--ease-out);
    padding-block: 6rem max(2.5rem, env(safe-area-inset-bottom));
  }

  h1 {
    margin: 0;
    font-size: var(--text-48);
    letter-spacing: -0.02em;
  }

  .word {
    display: inline-block;
    white-space: nowrap;
  }

  .char {
    display: inline-block;
    transform-origin: 50% 100%;
    transition:
      translate var(--dur-base) var(--ease-out),
      rotate var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  /* Letters hop under the pointer. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .char:hover {
      translate: 0 -0.12em;
      rotate: -6deg;
      color: var(--color-gold);
    }
  }

  .line {
    max-width: 34ch;
    margin: 1rem 0 0;
    font-size: var(--text-21);
    line-height: var(--line-snug);
  }

  /* Devanagari has no metric-matched fallback; the fallback wraps to a third line, so reserve it. */
  .line:lang(hi) {
    min-height: 3lh;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  /* On phones the status keeps a line of its own, so its live text can't re-wrap the buttons. */
  .actions :global(.status) {
    flex-basis: 100%;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* The entrance fills the whole first screen at every width. */
  @media (width >= 48rem) {
    .photo img {
      object-position: center;
    }

    .actions :global(.status) {
      flex-basis: auto;
    }

    h1 {
      font-size: var(--text-72);
    }
  }

  /* Two lines on wide screens, so the name stays left of the sign in the photograph. */
  @media (width >= 64rem) {
    h1 {
      max-width: 7em;
    }
  }

  @keyframes settle {
    from {
      transform: scale(var(--hero-scale));
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(var(--rise));
    }
  }

  /* Each letter turns up out of the page, one after another. */
  @keyframes flip {
    from {
      opacity: 0;
      transform: perspective(var(--perspective)) translateY(0.35em) rotateX(-95deg);
    }
  }

  :global([data-intro]) .photo {
    animation: settle var(--dur-hero) var(--ease-out) both;
  }

  :global([data-intro]) .char {
    animation: flip var(--dur-letter) var(--ease-out) both;
    animation-delay: calc(var(--intro-delay) + var(--c) * var(--stagger-letter));
  }

  :global([data-intro]) :is(.line, .actions) {
    animation: rise var(--dur-rise) var(--ease-out) both;
    animation-delay: calc(
      var(--intro-delay) + var(--letters) * var(--stagger-letter) + var(--i) * var(--stagger-hero)
    );
  }

  /* Scrolling away, the entrance sinks back and the words lift off and tip over. */
  @keyframes sink {
    to {
      scale: 1.22;
      translate: 0 16%;
    }
  }

  @keyframes lift-off {
    to {
      opacity: 0;
      transform: perspective(var(--perspective)) translateY(-14%) rotateX(32deg);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .photo img {
        animation: sink linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }

      .text {
        transform-origin: 50% 100%;
        animation: lift-off linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 75%;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo,
    .text {
      translate: none;
    }
  }
</style>
