---
/** The site's few icons: one 1.5px stroke on a 24px grid, used only where they carry meaning. */
const paths = {
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  previous: 'M15 5l-7 7 7 7',
  next: 'M9 5l7 7-7 7',
  arrow: 'M4 12h15M13 6l6 6-6 6',
  pin: 'M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0113 0C18.5 14.8 12 21 12 21zM12 12.2a2.4 2.4 0 100-4.8 2.4 2.4 0 000 4.8z',
  phone:
    'M6.6 3.5l2.6.4 1.2 3.4-1.8 1.5a12.5 12.5 0 006.6 6.6l1.5-1.8 3.4 1.2.4 2.6c0 .9-.8 1.6-1.7 1.6A16.7 16.7 0 015 5.2c0-.9.7-1.7 1.6-1.7z',
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>

<style>
  .icon {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
