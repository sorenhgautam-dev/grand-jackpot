---
import { primaryNav } from '../data/nav';
import { localePath, strings, type Locale } from '../lib/i18n';
import Button from './Button.astro';
import Icon from './Icon.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Logo from './Logo.astro';
import MenuDialog from './MenuDialog.astro';
import OpeningStatus from './OpeningStatus.astro';

interface Props {
  locale: Locale;
  path: string;
  /** Where the language switch points: this page in the other language. */
  languagePath: string;
  /** Clear over the home hero until it scrolls away. */
  overHero?: boolean;
}

const { locale, path, languagePath, overHero = false } = Astro.props;
const t = strings(locale);
const isCurrent = (itemPath: string) => path.startsWith(itemPath);
---

<header class="header" data-header data-surface="ink" data-over-hero={overHero ? '' : undefined}>
  <div class="bar wrap">
    <Logo locale={locale} current={path === '/'} />
    <nav class="primary" aria-label={t.a11y.mainNav}>
      <ul>
        {primaryNav.map((item) => (
          <li>
            <a
              href={localePath(locale, item.path)}
              aria-current={isCurrent(item.path) ? 'page' : undefined}
            >
              {t.nav[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="aside">
      <OpeningStatus locale={locale} class="header-status" />
      <LanguageSwitch locale={locale} path={languagePath} />
      <Button href={localePath(locale, '/visit/')}>{t.common.planVisit}</Button>
    </div>
    <button
      class="menu-button"
      commandfor="menu"
      command="show-modal"
      aria-haspopup="dialog"
      aria-controls="menu"
    >
      <Icon name="menu" />
      <span>{t.a11y.menu}</span>
    </button>
  </div>
</header>
<MenuDialog locale={locale} path={path} languagePath={languagePath} />

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-top: env(safe-area-inset-top);
    background: transparent;
  }

  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-bottom: var(--rule) solid var(--line);
    background: var(--bg);
    opacity: 1;
    transition: opacity var(--dur-quick) var(--ease-out);
  }

  :global(.js) .header[data-over-hero]:not([data-solid])::before {
    opacity: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-height);
  }

  .primary,
  .aside {
    display: none;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    margin-inline-end: -0.5rem;
    padding: 0 0.5rem;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-16);
    cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out);
  }

  .menu-button:active {
    transform: scale(var(--press-scale));
  }

  @media (width >= 64rem) {
    .menu-button {
      display: none;
    }

    .primary,
    .aside {
      display: flex;
      align-items: center;
    }

    .primary ul {
      display: flex;
      gap: 1.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* Small uppercase links, with a line that draws in under the one you point at. */
    .primary a {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      font-size: var(--text-label);
      font-weight: 600;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      text-decoration: none;
    }

    .primary a:lang(hi) {
      font-size: var(--text-16);
      letter-spacing: 0;
    }

    .primary a::after {
      content: '';
      position: absolute;
      right: 0;
      bottom: 0.6rem;
      left: 0;
      height: 1px;
      background: currentColor;
      scale: 0 1;
      transform-origin: 100% 50%;
      transition: scale var(--dur-hover) var(--ease-expo);
    }

    .primary [aria-current='page']::after {
      background: var(--accent);
      scale: 1 1;
    }

    .aside {
      gap: 1.25rem;
    }

    .header :global(.logo .name) {
      display: none;
    }
  }

  @media (hover: hover) and (width >= 64rem) {
    .primary a:hover::after {
      scale: 1 1;
      transform-origin: 0 50%;
    }
  }

  @media (width >= 80rem) {
    .header :global(.logo .name) {
      display: inline;
    }
  }
</style>
