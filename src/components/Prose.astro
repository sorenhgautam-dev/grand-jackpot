---
/** Long-form text from the content collections. */
interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
  }

  .prose :global(:is(h2, h3)) {
    margin: 3rem 0 1rem;
    font-size: var(--text-36);
  }

  .prose :global(h3) {
    font-size: var(--text-24);
  }

  .prose :global(:is(h2, h3):first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem;
  }

  .prose :global(:is(ul, ol)) {
    padding-inline-start: 1.5rem;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose :global(ol li::marker) {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin: 2rem 0 0.5rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 2px solid var(--color-copper);
    font-family: var(--font-display);
    font-size: var(--text-24);
    font-weight: 500;
    line-height: var(--line-snug);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(blockquote + p) {
    padding-inline-start: 1.25rem;
    font-size: var(--text-16);
    font-weight: 600;
  }
</style>
