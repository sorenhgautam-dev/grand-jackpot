---
import { primaryNav, secondaryNav } from '../data/nav';
import { directionsUrl, site } from '../data/site';
import { formatIntervals, formatPhone } from '../lib/format';
import { localePath, strings, type Locale } from '../lib/i18n';
import Button from './Button.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Ridge from './Ridge.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = strings(locale);

const dayTexts = site.hours.map((day) => formatIntervals(day, locale, t.hours));
const sameEveryDay = dayTexts.every((text) => text === dayTexts[0]);
const year = new Date().getFullYear();
---

<footer class="footer" data-surface="ink">
  <div class="wrap grid">
    <div class="place">
      <p class="name" lang="en">
        {site.name}
      </p>
      <address>
        {site.hotel}
        <br />
        {site.address.street}
        <br />
        {site.address.locality}, {site.address.country}
      </address>
      <Button href={directionsUrl} rel="noopener" variant="secondary" icon="pin">
        {t.common.directions}
      </Button>
    </div>

    <div class="contact">
      <p>
        <span class="label">{t.footer.hoursToday}</span>
        {sameEveryDay ? (
          <span>{dayTexts[0]}</span>
        ) : (
          <a href={`${localePath(locale, '/visit/')}#hours`}>{t.status.fallback}</a>
        )}
      </p>
      <p>
        <span class="label">{t.footer.call}</span>
        {site.phones.map((phone) => (
          <a class="phone" href={`tel:${phone}`}>
            {formatPhone(phone)}
          </a>
        ))}
      </p>
    </div>

    <nav class="links" aria-label={t.a11y.footerNav}>
      <ul>
        {[...primaryNav, ...secondaryNav].map((item) => (
          <li>
            <a href={localePath(locale, item.path)}>{t.nav[item.key]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="play">
      <p>{t.footer.entry}</p>
      <p>
        {t.footer.play}
        <a href={localePath(locale, '/responsible-gaming/')}>{t.footer.playLink}</a>
      </p>
    </div>

    <div class="base">
      <p>
        © {year} <span lang="en">{site.name}</span>
      </p>
      <LanguageSwitch locale={locale} path={path} />
    </div>
  </div>
  <div class="skyline">
    <Ridge draw />
  </div>
  <div class="wordmark" aria-hidden="true" lang="en">
    <span>{site.name}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--rule) solid var(--line);
    padding-top: var(--space-8);
    font-size: var(--text-16);
  }

  .grid {
    display: grid;
    gap: var(--space-7);
  }

  p {
    margin: 0;
  }

  .name {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-36);
    line-height: var(--line-tight);
  }

  address {
    font-style: normal;
    margin-bottom: 1rem;
  }

  .phone,
  .links a,
  .play a,
  .contact a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .contact {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .contact p {
    display: flex;
    flex-direction: column;
  }

  .phone {
    min-height: 2rem;
    font-variant-numeric: tabular-nums;
  }

  .links ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    text-decoration: none;
  }

  .play {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    max-width: 32ch;
  }

  .play a {
    min-height: auto;
    margin-inline-start: 0.25em;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: var(--rule) solid var(--line);
    font-size: var(--text-14);
  }

  .skyline {
    margin-top: var(--space-7);
    color: color-mix(in oklab, var(--color-gold) 70%, transparent);
  }

  /* The name, set wide in the italic serif, closes every page. */
  .wordmark {
    overflow: clip;
    padding-block: var(--space-5) max(var(--space-5), env(safe-area-inset-bottom));
    padding-inline: max(var(--gutter), env(safe-area-inset-left))
      max(var(--gutter), env(safe-area-inset-right));
  }

  .wordmark span {
    display: block;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 8.4vw;
    font-style: italic;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.015em;
    text-align: center;
    white-space: nowrap;
  }

  @keyframes wordmark-rise {
    from {
      translate: 0 70%;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .wordmark span {
        animation: wordmark-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @media (hover: hover) {
    .links a:hover {
      text-decoration: underline;
    }
  }

  @media (width >= 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .base {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 64rem) {
    .grid {
      grid-template-columns: 1.2fr 1fr 1.4fr 1.2fr;
    }
  }
</style>
