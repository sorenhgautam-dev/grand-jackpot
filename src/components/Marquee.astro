---
/**
 * The games' names in big type on a dark band: one row in the grotesk, one in the serif,
 * sliding in opposite directions as the page scrolls. The names are links elsewhere on the
 * page, so the band is decorative and hidden from assistive tech.
 */
interface Props {
  items: string[];
}

const { items } = Astro.props;
// Three runs, so the band always covers the window however far it slides.
const run = [...items, ...items, ...items];
const rows = [
  { face: 'grotesk', names: run },
  { face: 'serif', names: [...run].reverse() },
];
---

<div class="marquee" data-surface="charcoal" aria-hidden="true">
  {rows.map(({ face, names }) => (
    <p class="band" data-face={face}>
      {names.map((name) => (
        <>
          <span>{name}</span>
          <span class="dot" />
        </>
      ))}
    </p>
  ))}
</div>

<style>
  .marquee {
    overflow: clip;
    padding-block: var(--space-8);
  }

  .band {
    display: flex;
    align-items: center;
    gap: 0.35em;
    width: max-content;
    margin: 0;
    font-size: clamp(var(--text-48), 9vw, 10rem);
    line-height: 1.05;
    white-space: nowrap;
  }

  .band[data-face='grotesk'] {
    font-family: var(--font-grotesk);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  /* The serif row runs in outline: a stroke under an ink fill hides the font's overlaps. */
  .band[data-face='serif'] {
    font-family: var(--font-display);
    color: var(--bg);
    -webkit-text-stroke: 1.5px var(--fg);
    paint-order: stroke fill;
    translate: -30% 0;
  }

  /* Archivo has no Devanagari: Hindi names take the body face at its heaviest. */
  .band:lang(hi) {
    line-height: 1.5;
  }

  .band[data-face='grotesk']:lang(hi) {
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0;
  }

  .dot {
    flex: none;
    width: 0.16em;
    height: 0.16em;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }

  @keyframes slide-left {
    from {
      translate: 0 0;
    }

    to {
      translate: -30% 0;
    }
  }

  @keyframes slide-right {
    from {
      translate: -30% 0;
    }

    to {
      translate: 0 0;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band {
        animation: slide-left linear both;
        animation-timeline: view();
        animation-range: cover;
      }

      .band[data-face='serif'] {
        animation-name: slide-right;
      }
    }
  }
</style>
