---
/**
 * The games' names in big type, two bands sliding in opposite directions as the page scrolls.
 * The names are links elsewhere on the page, so this is decorative and hidden from assistive tech.
 */
interface Props {
  items: string[];
}

const { items } = Astro.props;
const suits = ['♠︎', '♥︎', '♦︎', '♣︎'];
// Three runs, so the band always covers the window however far it slides.
const run = [...items, ...items, ...items];
---

<div class="marquee" aria-hidden="true">
  <div class="tilt">
    {['solid', 'outline'].map((style) => (
      <p class="band" data-style={style}>
        {(style === 'outline' ? [...run].reverse() : run).map((item, index) => (
          <>
            <span class="item">{item}</span>
            <span class="suit">{suits[index % suits.length]}</span>
          </>
        ))}
      </p>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: clip;
    padding-block: 3rem;
    border-top: var(--rule) solid var(--hairline);
  }

  .tilt {
    rotate: -3deg;
  }

  .band {
    display: flex;
    align-items: center;
    gap: 0.4em;
    width: max-content;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-48), 9vw, var(--text-96) * 1.4);
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
  }

  .band:lang(hi) {
    line-height: 1.5;
  }

  .band[data-style='outline'] {
    /* The stroke sits under a paper fill, so the font's overlapping contours don't show. */
    color: var(--color-paper);
    -webkit-text-stroke: 2px var(--color-ink);
    paint-order: stroke fill;
    translate: -30% 0;
  }

  .suit {
    color: var(--color-copper);
    font-size: 0.5em;
  }

  .band[data-style='outline'] .suit {
    -webkit-text-stroke: 0;
    color: var(--color-red);
  }

  @keyframes slide-left {
    from {
      translate: 0 0;
    }

    to {
      translate: -30% 0;
    }
  }

  @keyframes slide-right {
    from {
      translate: -30% 0;
    }

    to {
      translate: 0 0;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band {
        animation: slide-left linear both;
        animation-timeline: view();
        animation-range: cover;
      }

      .band[data-style='outline'] {
        animation-name: slide-right;
      }
    }
  }
</style>
