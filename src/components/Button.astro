---
import Icon from './Icon.astro';

interface Props {
  /** Primary: solid gold, the one main action. Secondary: a ghost with a thin border. */
  variant?: 'primary' | 'secondary' | undefined;
  /** An icon before the label, for actions whose icon carries meaning (directions, call). */
  icon?: 'pin' | 'phone' | undefined;
  href?: string | undefined;
  type?: 'button' | 'submit' | undefined;
  rel?: string | undefined;
  class?: string | undefined;
  [data: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  icon,
  href,
  type = 'button',
  rel,
  class: className,
  ...data
} = Astro.props;
---

{href ? (
  <a href={href} rel={rel} class:list={['button', className]} data-variant={variant} {...data}>
    {icon && <Icon name={icon} />}
    <slot />
  </a>
) : (
  <button type={type} class:list={['button', className]} data-variant={variant} {...data}>
    {icon && <Icon name={icon} />}
    <slot />
  </button>
)}

<style>
  .button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--tap);
    padding: 0.5rem 1.25rem;
    border: var(--rule) solid transparent;
    border-radius: var(--radius-control);
    font: inherit;
    font-size: var(--text-16);
    font-weight: 600;
    line-height: var(--line-snug);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform var(--dur-press) var(--ease-out),
      translate var(--dur-follow) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .button :global(.icon) {
    width: 1.125rem;
    height: 1.125rem;
    margin-inline-start: -0.25rem;
  }

  .button:active {
    transform: scale(var(--press-scale));
  }

  [data-variant='primary'] {
    background: var(--color-gold);
    color: var(--color-obsidian);
  }

  /* A sheen crosses the primary button as the pointer arrives. */
  [data-variant='primary']::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, var(--glare) 50%, transparent 70%);
    translate: -110% 0;
    pointer-events: none;
  }

  [data-variant='secondary'] {
    border-color: var(--color-sage);
    background: transparent;
    color: var(--color-cream);
  }

  @media (hover: hover) {
    [data-variant='primary']:hover {
      background: var(--gold-bright);
    }

    [data-variant='primary']:hover::after {
      translate: 110% 0;
      transition: translate var(--dur-follow) var(--ease-out);
    }

    [data-variant='secondary']:hover {
      border-color: var(--color-gold);
      background: var(--wash);
    }
  }
</style>
