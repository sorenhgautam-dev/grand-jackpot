---
import Icon from './Icon.astro';

interface Props {
  /** Primary: solid gold, the one main action in a view. Secondary: outlined in gold. */
  variant?: 'primary' | 'secondary' | undefined;
  /** An icon before the label, where it carries meaning (directions, call). */
  icon?: 'pin' | 'phone' | undefined;
  href?: string | undefined;
  type?: 'button' | 'submit' | undefined;
  rel?: string | undefined;
  class?: string | undefined;
  [data: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  icon,
  href,
  type = 'button',
  rel,
  class: className,
  ...data
} = Astro.props;
/** Links that go somewhere carry an arrow; actions with their own icon don't need one. */
const arrow = Boolean(href) && !icon;
---

{href ? (
  <a href={href} rel={rel} class:list={['button', className]} data-variant={variant} {...data}>
    {icon && <Icon name={icon} />}
    <span class="text">
      <slot />
    </span>
    {arrow && <Icon name="arrow" class="arrow" />}
  </a>
) : (
  <button type={type} class:list={['button', className]} data-variant={variant} {...data}>
    {icon && <Icon name={icon} />}
    <span class="text">
      <slot />
    </span>
  </button>
)}

<style>
  .button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: calc(var(--tap) + var(--space-1));
    padding: var(--space-2) var(--space-5);
    border: var(--rule) solid transparent;
    border-radius: var(--radius-control);
    font: inherit;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    line-height: var(--line-snug);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform var(--dur-press) var(--ease-out),
      color var(--dur-hover) var(--ease-expo),
      border-color var(--dur-hover) var(--ease-expo);
  }

  .button:lang(hi) {
    font-size: var(--text-16);
    letter-spacing: 0;
  }

  /* The hover fill: rises from the bottom edge. */
  .button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    scale: 1 0;
    transform-origin: 50% 100%;
    transition: scale var(--dur-hover) var(--ease-expo);
  }

  .button :global(.icon) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .button :global(.arrow) {
    margin-inline-end: calc(-1 * var(--space-1));
    transition: translate var(--dur-hover) var(--ease-expo);
  }

  .button:active {
    transform: scale(var(--press-scale));
  }

  [data-variant='primary'] {
    background: var(--action);
    color: var(--action-fg);
  }

  /* Gold fills to white under the pointer; the dark label keeps 19:1 either way. */
  [data-variant='primary']::before {
    background: var(--fg);
  }

  [data-variant='secondary'] {
    border-color: var(--accent);
    background: transparent;
    color: var(--fg);
  }

  [data-variant='secondary']::before {
    background: var(--action);
  }

  @media (hover: hover) {
    .button:hover::before {
      scale: 1 1;
    }

    .button:hover :global(.arrow) {
      translate: var(--space-1) 0;
    }

    [data-variant='secondary']:hover {
      border-color: var(--action);
      color: var(--action-fg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button::before,
    .button :global(.arrow) {
      transition: none;
    }
  }
</style>
