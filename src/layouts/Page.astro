---
import type { ImageMetadata } from 'astro';
import Photo from '../components/Photo.astro';
import type { Locale } from '../lib/i18n';
import Base from './Base.astro';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  intro?: string | undefined;
  photo?: ImageMetadata | undefined;
  photoAlt?: string | undefined;
  /** The link-preview image when the header has no photo. */
  ogImage?: ImageMetadata | undefined;
  /** Shared with the card that links here, so the photo and title travel between pages. */
  transitionKey?: string | undefined;
  indexable?: boolean | undefined;
}

const {
  locale,
  path,
  title,
  description,
  intro,
  photo,
  photoAlt = '',
  transitionKey,
  indexable,
  ogImage,
} = Astro.props;
---

<Base
  locale={locale}
  path={path}
  title={title}
  description={description}
  image={photo ?? ogImage}
  imageAlt={photoAlt}
  indexable={indexable}
>
  <header class:list={['page-header wrap', { 'has-photo': photo, arrives: !transitionKey }]}>
    <div class="text">
      <slot name="before-title" />
      <h1 style={transitionKey ? `view-transition-name: ${transitionKey}-title` : undefined}>
        {title}
      </h1>
      {intro && <p class="intro">{intro}</p>}
      <slot name="after-intro" />
    </div>
    {photo && (
      <Photo
        src={photo}
        alt={photoAlt}
        ratio="landscape"
        sizes="(min-width: 64rem) 60rem, 100vw"
        priority
        transitionName={transitionKey && `${transitionKey}-photo`}
        class="header-photo"
      />
    )}
  </header>
  <slot />
</Base>

<style>
  /* Every inner page opens like a chapter of the home page: a centred title and introduction,
     and the page's photograph below them, framed by the margins. */
  .page-header {
    display: grid;
    justify-items: center;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  .text {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: var(--text-page);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  h1:lang(hi) {
    line-height: var(--line-snug);
    letter-spacing: 0;
  }

  .intro {
    max-width: 44ch;
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-18);
    line-height: var(--line-body);
  }

  .page-header :global(.header-photo) {
    width: 100%;
    max-width: 60rem;
  }

  /* The title rises out from behind its own bottom edge, and the rest follows; pages that
     share a title with the link that led here let the view transition carry it instead. */
  @keyframes title-in {
    from {
      clip-path: inset(92% -0.5em -0.5em -0.5em);
      translate: 0 0.3em;
    }

    to {
      clip-path: inset(-0.5em);
      translate: 0 0;
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0.01;
      translate: 0 var(--reveal-rise);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .arrives h1 {
      animation: title-in var(--dur-reveal) var(--ease-expo) both;
    }

    .arrives .text > :global(:not(h1)) {
      animation: rise-in var(--dur-reveal) var(--ease-expo) 180ms both;
    }
  }

  @media (width >= 64rem) {
    .page-header {
      padding-block: var(--space-9);
    }
  }
</style>
