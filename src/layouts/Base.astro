---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import entrance from '../assets/photos/entrance.jpg';
import Chip from '../components/Chip.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import { isDemo } from '../lib/demo';
import { intlLocale, localePath, locales, strings, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** The page's path without its language prefix. */
  path: string;
  title: string;
  description: string;
  /** The Open Graph image; the entrance by default. */
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  /** The home page: a clear header over the hero. */
  home?: boolean;
  /** Pages that exist in one form only, such as 404, carry no canonical or alternates. */
  indexable?: boolean | undefined;
  jsonLd?: Record<string, unknown> | undefined;
}

const {
  locale,
  path,
  title,
  description,
  image = entrance,
  imageAlt,
  home = false,
  indexable = true,
  jsonLd,
} = Astro.props;
const t = strings(locale);
// Preload every face a page sets text in, so no font is discovered late. Fraunces sets
// the headings (upright and italic); Mukta the text. Hindi pages need Tiro and Mukta's Devanagari.
const muktaPreloads = [
  { subset: 'latin', weight: '400' },
  { subset: 'latin', weight: '600' },
  ...(locale === 'hi'
    ? [
        { subset: 'devanagari', weight: '400' },
        { subset: 'devanagari', weight: '600' },
      ]
    : []),
];
// Pages with no counterpart in the other language switch to its home page.
const languagePath = indexable ? path : '/';
const fullTitle = home ? title : `${title} | ${site.name}`;
const canonical = new URL(localePath(locale, path), Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(isDemo || !indexable) && <meta name="robots" content="noindex, nofollow" />}
    {indexable && (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((other) => (
          <link
            rel="alternate"
            hreflang={other}
            href={new URL(localePath(other, path), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localePath('en', path), Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={intlLocale[locale].replace('-', '_')} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? t.wayIn.stops[4]?.alt ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f6f2e8" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }, { style: 'italic' }]} />
    <Font cssVariable="--font-tiro" preload={locale === 'hi'} />
    <Font cssVariable="--font-mukta" preload={muktaPreloads} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // The curtain plays once per visit, and never for people who ask for less motion.
      try {
        if (
          !sessionStorage.getItem('gj-seen') &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('intro');
          sessionStorage.setItem('gj-seen', '1');
        }
      } catch {
        // Storage is blocked: skip the curtain.
      }
    </script>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="preloader" aria-hidden="true">
      <Chip class="spinner" />
      <span class="namaste" lang="ne">
        नमस्ते
      </span>
      <span class="name" lang="en">
        {site.name}
      </span>
    </div>
    <a class="skip" href="#main">
      {t.a11y.skip}
    </a>
    <Header locale={locale} path={path} languagePath={languagePath} overHero={home} />
    <main id="main" tabindex="-1" class:list={[{ 'under-header': !home }]}>
      <slot />
    </main>
    <Footer locale={locale} path={languagePath} />
    <script>
      import '../scripts/image-fade';
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  /* The curtain: a chip flips, "namaste" and the name settle under it, and the whole thing
     lifts away in about a second and a half. CSS alone ends it, so it can never hang. */
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    place-items: center;
    align-content: center;
    justify-items: center;
    gap: var(--space-3);
    background: var(--color-felt-deep);
    color: var(--color-gold-light);
    font-family: var(--font-display);
    font-size: var(--text-24);
    font-style: italic;
  }

  :global(html.intro) {
    --intro: 1150ms;
  }

  :global(html.intro) .preloader {
    display: grid;
    animation: curtain 650ms var(--ease-in-out) 900ms forwards;
  }

  :global(html.intro) .preloader :global(.spinner) {
    width: 5rem;
    animation: flip 900ms var(--ease-expo) both;
  }

  .preloader :global(.spinner) {
    margin-bottom: var(--space-3);
  }

  .preloader .namaste {
    font-family: var(--font-native-label);
    font-size: var(--text-21);
    font-style: normal;
    letter-spacing: 0.02em;
  }

  :global(html.intro) .preloader .namaste {
    animation: name-in 700ms var(--ease-expo) 120ms both;
  }

  :global(html.intro) .preloader .name {
    animation: name-in 700ms var(--ease-expo) 240ms both;
  }

  @keyframes curtain {
    to {
      translate: 0 -100%;
      visibility: hidden;
    }
  }

  @keyframes flip {
    from {
      opacity: 0;
      rotate: y 540deg;
      scale: 0.5;
    }
  }

  @keyframes name-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  .skip {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 20;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-control);
    background: var(--action);
    color: var(--action-fg);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  /* The header is fixed; every page but home starts below it (home's hero runs under it). */
  .under-header {
    padding-top: calc(var(--header-full) + env(safe-area-inset-top));
  }
</style>
