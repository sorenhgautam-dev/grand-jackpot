---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import entrance from '../assets/photos/entrance.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import { isDemo } from '../lib/demo';
import { intlLocale, localePath, locales, strings, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** The page's path without its language prefix. */
  path: string;
  title: string;
  description: string;
  /** The Open Graph image; the entrance by default. */
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  /** The home page: a clear header over the hero, and the hero's once-per-session intro. */
  home?: boolean;
  /** Pages that exist in one form only, such as 404, carry no canonical or alternates. */
  indexable?: boolean | undefined;
  jsonLd?: Record<string, unknown> | undefined;
}

const {
  locale,
  path,
  title,
  description,
  image = entrance,
  imageAlt,
  home = false,
  indexable = true,
  jsonLd,
} = Astro.props;
const t = strings(locale);
// Hindi pages mix Devanagari with the Latin brand name; Devanagari has no metric-matched fallback.
const eczarPreloads =
  locale === 'hi' ? [{ subset: 'latin' }, { subset: 'devanagari' }] : [{ subset: 'latin' }];
const muktaPreloads =
  locale === 'hi'
    ? [
        { subset: 'devanagari', weight: '400' },
        { subset: 'devanagari', weight: '600' },
      ]
    : [{ subset: 'latin', weight: '400' }];
// Pages with no counterpart in the other language switch to its home page.
const languagePath = indexable ? path : '/';
const fullTitle = home ? title : `${title} | ${site.name}`;
const canonical = new URL(localePath(locale, path), Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(isDemo || !indexable) && <meta name="robots" content="noindex, nofollow" />}
    {indexable && (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((other) => (
          <link
            rel="alternate"
            hreflang={other}
            href={new URL(localePath(other, path), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localePath('en', path), Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={intlLocale[locale].replace('-', '_')} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? t.wayIn.stops[4]?.alt ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f6f1e9" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-eczar" preload={eczarPreloads} />
    <Font cssVariable="--font-mukta" preload={muktaPreloads} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {home && <script is:inline>
      try {
        if (
          !sessionStorage.getItem('gj-intro') &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.dataset.intro = '';
          sessionStorage.setItem('gj-intro', '1');
        }
      } catch {
        /* Storage blocked: skip the intro. */
      }
    </script>}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">
      {t.a11y.skip}
    </a>
    <Header locale={locale} path={path} languagePath={languagePath} overHero={home} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} path={languagePath} />
    <script>
      import '../scripts/image-fade';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 20;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-control);
    background: var(--color-ink);
    color: var(--color-paper);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
